module shifter(input  logic [31:0] A,
               input  logic [4:0]  Shamt,
               input  logic [1:0]  ShiftType,
               output logic [31:0] Y);

    always_comb begin
        case (ShiftType)
            2'b00: Y = A << Shamt;   // LSL
            default: Y = A;          // other shifts not implemented yet
        endcase
    end

endmodule