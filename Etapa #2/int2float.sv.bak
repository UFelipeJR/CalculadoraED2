module int2float(
	input logic [31:0] A,
	output logic [31:0] C
);

	logic sign;
	logic [31:0] abs_value;
	logic [7:0] expo;
	logic [22:0] mantissa;
	logic [4:0] msb_index;
	logic [31:0] normalized;

	always_comb begin
		sign = A[31];
		abs_value = sign ? (~A + 1'b1) : A;
		expo = 0;
		mantissa = 0;
		msb_index = 0;
		normalized = 0;

		if (A == 0) begin
			C = 32'b0;
		end else begin
			casez (abs_value)
				32'b1???????????????????????????????: msb_index = 31;
				32'b01??????????????????????????????: msb_index = 30;
				32'b001?????????????????????????????: msb_index = 29;
				32'b0001????????????????????????????: msb_index = 28;
				32'b00001???????????????????????????: msb_index = 27;
				32'b000001??????????????????????????: msb_index = 26;
				32'b0000001?????????????????????????: msb_index = 25;
				32'b00000001????????????????????????: msb_index = 24;
				32'b000000001???????????????????????: msb_index = 23;
				32'b0000000001??????????????????????: msb_index = 22;
				32'b00000000001?????????????????????: msb_index = 21;
				32'b000000000001????????????????????: msb_index = 20;
				32'b0000000000001???????????????????: msb_index = 19;
				32'b00000000000001??????????????????: msb_index = 18;
				32'b000000000000001?????????????????: msb_index = 17;
				32'b0000000000000001????????????????: msb_index = 16;
				32'b00000000000000001???????????????: msb_index = 15;
				32'b000000000000000001??????????????: msb_index = 14;
				32'b0000000000000000001?????????????: msb_index = 13;
				32'b00000000000000000001????????????: msb_index = 12;
				32'b000000000000000000001???????????: msb_index = 11;
				32'b0000000000000000000001??????????: msb_index = 10;
				32'b00000000000000000000001?????????: msb_index = 9;
				32'b000000000000000000000001????????: msb_index = 8;
				32'b0000000000000000000000001???????: msb_index = 7;
				32'b00000000000000000000000001??????: msb_index = 6;
				32'b000000000000000000000000001?????: msb_index = 5;
				32'b0000000000000000000000000001????: msb_index = 4;
				32'b00000000000000000000000000001???: msb_index = 3;
				32'b000000000000000000000000000001??: msb_index = 2;
				32'b0000000000000000000000000000001?: msb_index = 1;
				32'b00000000000000000000000000000001: msb_index = 0;
				default: msb_index = 0;
			endcase

			expo = msb_index + 8'd127;

			if (msb_index >= 23)
				normalized = abs_value >> (msb_index - 23);
			else
				normalized = abs_value << (23 - msb_index);

			mantissa = normalized[22:0];
			C = {sign, expo, mantissa};
		end
	end

endmodule