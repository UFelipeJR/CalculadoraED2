module main(
	input logic [31:0] A,
	input logic [31:0] B,
	output logic [31:0] C
);

	div_pf uut(
		.A(A),
		.B(B),
		.C(C)
	);

endmodule


module tb_main;

	logic [31:0] A;
	logic [31:0] B;
	logic [31:0] C;

	main dut(
		.A(A),
		.B(B),
		.C(C)
		
	);

	initial begin
		//A = 32'h3F800000; #10;
		//A = 32'h40000000; #10;
		//A = 32'h40400000; #10;
		//A = 32'h40800000; #10;
		//A = 32'h40A00000; #10;

		A = 32'h40C00000; B = 32'h40000000; #10;
		A = 32'hC1100000; B = 32'h40400000; #10;
		A = 32'hC1000000; B = 32'hC0000000; #10;
		A = 32'h3F800000; B = 32'h40800000; #10;
		A = 32'h40A00000; B = 32'h00000000; #10;
		A = 32'h00000000; B = 32'h40A00000; #10;
		A = 32'h7F800000; B = 32'h40000000; #10;
		A = 32'h7FC00000; B = 32'h40000000; #10;
		$stop;
	end

endmodule
